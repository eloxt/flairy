{
  "name": "@flairy/desktop",
  "version": "0.5.0",
  "description": "Desktop AI coding agent built on pi-agent-core + Electron",
  "main": "./out/main/index.js",
  "author": "eloxt",
  "license": "MIT",
  "type": "module",
  "build": {
    "appId": "com.eloxt.flairy",
    "productName": "Flairy",
    "publish": {
      "provider": "github",
      "owner": "eloxt",
      "repo": "flairy",
      "releaseType": "draft"
    },
    "dmg": {
      "window": {
        "width": 540,
        "height": 420
      },
      "contents": [
        {
          "x": 130,
          "y": 180
        },
        {
          "x": 410,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 330,
          "type": "file",
          "path": "build/install.command",
          "name": "安装 Flairy.command"
        }
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/bin/darwin-arm64",
          "to": "bin"
        },
        {
          "from": "resources/tray",
          "to": "tray"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/bin/win32-x64",
          "to": "bin"
        },
        {
          "from": "resources/tray",
          "to": "tray"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "differentialPackage": true
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "icons": "node scripts/generate-icons.mjs",
    "package": "electron-vite build && electron-builder",
    "package:mac": "electron-vite build && electron-builder --mac",
    "lint": "eslint .",
    "postinstall": "electron-rebuild -f",
    "rebuild": "electron-rebuild -f"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@base-ui/react": "^1.6.0",
    "@earendil-works/pi-agent-core": "^0.81.1",
    "@earendil-works/pi-ai": "^0.81.1",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@flairy/shared": "workspace:*",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/auth-oauth-device": "^8.0.3",
    "@octokit/rest": "^22.0.1",
    "@pierre/diffs": "^1.2.12",
    "@pierre/trees": "1.0.0-beta.5",
    "@shadcn/react": "^0.2.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tabler/icons-react": "^3.45.0",
    "better-sqlite3": "^13.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "electron-liquid-glass": "^1.1.1",
    "electron-updater": "^6.8.9",
    "grammy": "^1.45.1",
    "i18next": "^26.3.6",
    "katex": "^0.18.1",
    "react-i18next": "^17.0.11",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.14.1",
    "socket.io-client": "^4.8.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "typebox": "^1.3.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
