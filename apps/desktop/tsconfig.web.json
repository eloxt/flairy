{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/**/*",
    "src/preload/index.d.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    // The renderer is bundled by Vite; use Bundler resolution (matches
    // tsconfig.node.json) so deps with an `exports` map (e.g. react-router v8)
    // resolve. The electron-toolkit base sets the classic "node" resolver.
    "moduleResolution": "Bundler",
    // TS 7 errors on side-effect imports with no type declarations (TS2882);
    // vite/client supplies the `*.css` (and other asset) module declarations.
    // Deliberately NOT including "node" here — the renderer must not see Node.
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
